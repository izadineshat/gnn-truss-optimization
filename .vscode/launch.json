{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File (Run / Debug)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: truss_week1_review.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/week1/truss_week1_review.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "truss-fem (canonical truss)",
      "type": "debugpy",
      "request": "launch",
      "module": "trussgnn.cli",
      "args": ["--load", "-100000"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "pytest (all tests)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}